# Postgres (docker compose publishes it on 5433 to avoid clashing with other local Postgres)
DATABASE_URL=postgres://mny:mny@localhost:5433/mny

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173

# Ports
SERVER_PORT=4000
COLLAB_PORT=4001

# Origin of the web client (CORS + trusted origins)
CLIENT_ORIGIN=http://localhost:5173
