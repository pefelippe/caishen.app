# ---- Web (Next.js) ----
# Backend URL the Next.js rewrites proxy to (server-side only).
API_URL=http://localhost:4000

# ---- API (Express) ----
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Postgres (Drizzle / Better Auth)
DATABASE_URL=postgres://caishen:caishen@localhost:5432/caishen

# Better Auth. BETTER_AUTH_URL is the origin the browser hits (the web app,
# which proxies /api/auth to this backend), so cookies stay first-party.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Email (Resend) — magic-link delivery. Without a key the link is logged to
# the API console in dev. EMAIL_FROM must be a Resend-verified sender.
RESEND_API_KEY=
EMAIL_FROM=Caishen <onboarding@resend.dev>

# AI (Anthropic Claude) — used by /ai/insights
ANTHROPIC_API_KEY=

# WhatsApp integration
WHATSAPP_VERIFY_TOKEN=
TWILIO_AUTH_TOKEN=
