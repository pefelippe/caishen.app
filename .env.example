# Postgres (docker compose publishes it on 5433 to avoid clashing with other local Postgres)
DATABASE_URL=postgres://mny:mny@localhost:5433/mny

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth (the only sign-in method). Create a "Web application" OAuth Client in the Google
# Cloud Console with origin http://localhost:5173 and redirect URI
# http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ports
SERVER_PORT=4000
COLLAB_PORT=4001

# Origin of the web client (CORS + trusted origins)
CLIENT_ORIGIN=http://localhost:5173

# Demo mode: shows "Entrar na demo" on the login page, signing in as a shared mocked User
# (demo@mny.local) without Google. Never enable in production.
DEMO_MODE=false
