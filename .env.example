# Postgres (docker compose publishes it on 5433 to avoid clashing with other local Postgres)
DATABASE_URL=postgres://zapbots:zapbots@localhost:5433/zapbots

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173

# Sign-in by email link. With RESEND_API_KEY (https://resend.com/api-keys) the link is emailed
# from EMAIL_FROM (a verified domain; onboarding@resend.dev only reaches your own address).
# Without it the link is printed on the server console, which is enough locally.
RESEND_API_KEY=
EMAIL_FROM=

# Google OAuth (optional second sign-in; the button shows only when both are set). Create a "Web application" OAuth Client in the Google
# Cloud Console with origin http://localhost:5173 and redirect URI
# http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ports
SERVER_PORT=4000

# Origin of the web client (CORS + trusted origins)
CLIENT_ORIGIN=http://localhost:5173


# Bots (docs/adr/0009): one OpenRouter key for every Model, free ones included.
# Create it at https://openrouter.ai/keys. Without it the app runs and the Bots stay silent.
OPENROUTER_API_KEY=
# Model for Bots that have none chosen. Empty picks OpenRouter's free router.
OPENROUTER_DEFAULT_MODEL=

# Google Drive Connection: the file picker runs in the browser and needs an API key (with the
# Google Picker API enabled) and the Cloud project number. Also enable the Google Drive API.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# Billing (docs/adr/0011): the Pro Plan is sold through Stripe Checkout. Without these the app
# runs on the free Plan and the Faturamento page says billing is not configured.
# STRIPE_PRICE_PRO is the id of a recurring monthly Price (price_...). For the webhook, point
# Stripe at /api/billing/webhook (locally: `stripe listen --forward-to localhost:4000/api/billing/webhook`)
# with the events checkout.session.completed and customer.subscription.*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
