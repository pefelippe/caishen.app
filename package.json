{
  "name": "zapbots",
  "version": "0.0.0",
  "private": true,
  "description": "AI teammates: Bots que entram nas suas ferramentas e voltam com o trabalho pronto.",
  "scripts": {
    "tui": "node scripts/tui.mts",
    "build": "turbo run build",
    "clean": "rm -rf node_modules {apps,packages,packages/bots}/*/node_modules {apps,packages,packages/bots}/*/dist .turbo {apps,packages,packages/bots}/*/.turbo",
    "codegen": "turbo run codegen",
    "db:generate": "pnpm --filter @zapbots/database db:generate",
    "db:migrate": "pnpm --filter @zapbots/database db:migrate",
    "usage-code": "pnpm --filter @zapbots/server usage-code",
    "dev": "turbo run dev",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d postgres",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "lint:tsc": "turbo run lint:tsc",
    "test:unit": "turbo run test:unit"
  },
  "devDependencies": {
    "@types/node": "24.13.0",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "turbo": "2.9.18",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.13.0"
  },
  "packageManager": "pnpm@11.5.1"
}
