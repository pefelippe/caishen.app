{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.md",
    "**/*.json",
    "**/*.jsonc",
    "**/*.json5",
    "**/*.yaml",
    "**/*.yml",
    ".github",
    "**/__generate_prompts__/generations/**",
    "*.graphql",
    "**/generated/**",
    ".serverless",
    ".DS_Store",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/cdk.out/**",
    ".idea",
    "TODO*",
    "tags",
    ".turbo",
    ".env",
    ".env-*",
    "*.log",
    ".turbo",
    ".cache",
    "task-definition.json",
    "./report.*",
    ".vscode/",
    ".editorconfig",
    ".localstack/volume",
    "volume/**"
  ]
}
