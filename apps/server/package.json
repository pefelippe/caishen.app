{
  "name": "@zapbots/server",
  "version": "0.0.0",
  "private": true,
  "description": "GraphQL API and Better Auth endpoints.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "lint:tsc": "tsc",
    "usage-code": "tsx --env-file-if-exists=../../.env src/scripts/usageCode.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "test:unit": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@apollo/server": "5.5.0",
    "@as-integrations/express5": "1.1.2",
    "@sentry/node": "11.8.0",
    "@vercel/functions": "3.10.1",
    "@zapbots/ai": "workspace:*",
    "@zapbots/auth": "workspace:*",
    "@zapbots/database": "workspace:*",
    "@zapbots/finance": "workspace:*",
    "@zapbots/fitness": "workspace:*",
    "@zapbots/personal": "workspace:*",
    "@zapbots/graphql": "workspace:*",
    "better-auth": "1.7.6",
    "cors": "2.8.5",
    "drizzle-orm": "0.45.2",
    "express": "5.2.0",
    "graphql": "16.12.0",
    "tsx": "4.21.0",
    "unpdf": "1.9.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.13",
    "@types/express": "5.0.4",
    "@zapbots/typescript-config": "workspace:*",
    "msw": "3.0.3",
    "vitest": "4.1.10"
  }
