    "@mny/finance": "workspace:*",
    "@mny/graphql": "workspace:*",
    "better-auth": "1.7.6",
    "cors": "2.8.5",
    "drizzle-orm": "0.45.2",
    "express": "5.2.0",
    "graphql": "16.12.0",
    "tsx": "4.21.0",
    "yjs": "13.6.28"
  },
  "devDependencies": {
    "@mny/typescript-config": "workspace:*",
